# Build-time settings for the static site. ALL VITE_* VALUES ARE PUBLIC (bundled into the JS): never put a secret here.
# The RailRadar key is NOT configured here — each visitor enters their own on the "Live data" tab.

# Raster tile URL template for the map, e.g. https://tiles.example.com/{z}/{x}/{y}.png (blank background if empty).
# Do NOT use OSM's public tile servers for production traffic (AGENTS.md §5).
VITE_TILE_SOURCE_URL=

# Optional: a proxy that holds a shared key server-side (enables live for everyone; needs a server-side component).
VITE_RAILRADAR_BASE_URL=

VITE_MONTHLY_REQUEST_BUDGET=1000
VITE_STATION_BOARD_TTL_S=75
VITE_TRAIN_LIVE_TTL_S=50
VITE_STALE_AFTER_SECONDS=300
VITE_MAX_STALE_SECONDS=1800
