# TN Rail Tracker — environment variables (AGENTS.md §10)
# Copy to .env and fill in. NEVER commit .env; redact keys from logs/fixtures.

# --- Providers ------------------------------------------------------------
# Timetable source. datameet = free CC0 snapshot (~2016), offline, no quota.
STATIC_SOURCE=datameet
# Live overlay: none (timetable only) | railradar (spends quota; needs the key below).
LIVE_SOURCE=none
# RailRadar API key (https://api.railradar.in). NEVER commit; never log.
RAILRADAR_API_KEY=

# --- Storage --------------------------------------------------------------
# Quota ledger (JSONL). See docs/decisions/0001-no-db-redis-v1.md for why no DB/Redis yet.
LEDGER_PATH=data/quota_ledger.jsonl

# --- Quota / freshness ----------------------------------------------------
MONTHLY_REQUEST_BUDGET=1000
POLL_MODE=on_demand
STATION_BOARD_TTL_S=75
TRAIN_LIVE_TTL_S=50
STALE_AFTER_SECONDS=300
MAX_STALE_SECONDS=1800

# --- Map tiles ------------------------------------------------------------
# Do NOT point this at OSM public tile servers for production (see AGENTS.md §5).
TILE_SOURCE_URL=

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
