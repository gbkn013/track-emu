# TN Rail Tracker — environment variables (AGENTS.md §10)
# Copy to .env and fill in. NEVER commit .env; redact keys from logs/fixtures.

# --- Provider -------------------------------------------------------------
# RailRadar live API key (https://api.railradar.in). Phase 0 + dev-live only.
RAILRADAR_API_KEY=

# Which provider the app uses: railradar (spends quota) | replay (fixtures, offline)
PROVIDER=replay

# --- Storage --------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/tntt.db
REDIS_URL=redis://localhost:6379/0

# --- Quota / freshness ----------------------------------------------------
MONTHLY_REQUEST_BUDGET=1000
POLL_MODE=on_demand
STATION_BOARD_TTL_S=75
TRAIN_LIVE_TTL_S=50
STALE_AFTER_SECONDS=300
MAX_STALE_SECONDS=1800

# --- Map tiles ------------------------------------------------------------
# Do NOT point this at OSM public tile servers for production (see AGENTS.md §5).
TILE_SOURCE_URL=

# --- Misc -----------------------------------------------------------------
LOG_LEVEL=INFO
